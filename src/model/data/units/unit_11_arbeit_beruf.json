    "grammarGuide": [
        {
            "heading": "Berufe und Artikel",
            "explanation": "Im Portugiesischen verwendet man normalerweise *keinen* unbestimmten Artikel (um/uma), wenn man über den eigenen Beruf spricht.",
            "examples": [
                "Eu sou médico. (Ich bin Arzt. -> NICHT: Eu sou um médico.)",
                "Ela é professora. (Sie ist Lehrerin.)"
            ]
        },
        {
            "heading": "Präpositionen am Arbeitsplatz",
            "explanation": "Um zu sagen, *wo* oder *für wen* du arbeitest, benutzt man die Präpositionen 'em' (in/bei) und 'para' (für).",
            "examples": [
                "Eu trabalho num escritório. (Ich arbeite in einem Büro. -> em + um = num)",
                "Eu trabalho para uma empresa alemã. (Ich arbeite für ein deutsches Unternehmen.)"
            ]
        },
        {
            "heading": "Trabalhar (arbeiten)",
            "explanation": "Ein regelmäßiges Verb auf -ar, das extrem wichtig im Alltag ist.",
            "examples": [
                "eu trabalho, tu trabalhas, ele/ela trabalha",
                "nós trabalhamos, eles/elas trabalham",
                "Eles trabalham muito. (Sie arbeiten viel.)"
            ]
        }
    ]
}