    "grammarGuide": [
        {
            "heading": "Saudade – Das unübersetzbare Wort",
            "explanation": "Saudade ist wohl das berühmteste portugiesische Wort. Es beschreibt ein tiefes Gefühl von Sehnsucht, Melancholie oder den Schmerz über die Abwesenheit von jemandem oder etwas. Man kann Saudade nach einem Ort, einer Person oder sogar einer vergangenen Zeit haben.",
            "examples": [
                "Tenho saudades tuas. (Ich vermisse dich / Ich habe Sehnsucht nach dir.)",
                "Tenho saudades de Portugal. (Ich vermisse Portugal.)"
            ]
        },
        {
            "heading": "Die Füllwörter: Pois und Pois é",
            "explanation": "Wer in Portugal Gesprächen lauscht, hört ständig 'Pois' oder 'Pois é'. Es sind die ultimativen Füllwörter, um Zustimmung zu signalisieren. Es bedeutet so viel wie 'Genau', 'Tja' oder 'So ist es'.",
            "examples": [
                "— Está muito frio hoje! (Es ist sehr kalt heute!)",
                "— Pois é... (Ja, genau... / Wem sagst du das...)"
            ]
        },
        {
            "heading": "Os Santos Populares",
            "explanation": "Im Juni feiert ganz Portugal die 'Santos Populares' (Volksheilige). In Lissabon feiert man Santo António (13. Juni), in Porto São João (24. Juni). Es gibt Straßenfeste, gegrillte Sardinen, Basilikumtöpfchen (Manjerico) und überall Musik.",
            "examples": [
                "No Santo António comemos sardinhas assadas. (An Santo António essen wir gegrillte Sardinen.)"
            ]
        }
    ]
}