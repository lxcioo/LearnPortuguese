    "grammarGuide": [
        {
            "heading": "Die Meinung sagen: 'Achar' vs. 'Pensar'",
            "explanation": "Wenn Portugiesen ihre eigene Meinung zu einem Thema ausdrücken, benutzen sie fast immer das Verb 'achar' (wörtlich: finden). Das Verb 'pensar' nutzt man eher für den physischen Akt des Nachdenkens.",
            "examples": [
                "Eu acho que a casa é bonita. (Ich denke/finde, dass das Haus schön ist.)",
                "Estou a pensar no meu trabalho. (Ich denke gerade an meine Arbeit.)"
            ]
        },
        {
            "heading": "Einleitung in den Conjuntivo",
            "explanation": "Der 'Conjuntivo' ist der portugiesische Konjunktiv. Anders als im Deutschen wird er im Alltag ständig benutzt! Er wird immer dann fällig, wenn eine Aussage nicht absolut objektiv ist, sondern subjektiv gefärbt ist (Wunsch, Zweifel, Gefühl). Die Struktur ist oft: 'Gefühl/Wunsch + que + neues Subjekt + Conjuntivo-Verb'.",
            "examples": [
                "Espero que tu estejas bem. (Ich hoffe, dass es dir gut geht. -> 'estejas' ist der Conjuntivo von 'estar')."
            ]
        },
        {
            "heading": "Wörter, die den Conjuntivo auslösen",
            "explanation": "Merke dir für den Anfang feste Ausdrücke, nach denen sich das nächste Verb verändern muss. Die wichtigsten sind: Espero que (Ich hoffe, dass), Duvido que (Ich bezweifle, dass), Talvez (Vielleicht), É possível que (Es ist möglich, dass).",
            "examples": [
                "Talvez ele venha. (Vielleicht kommt er. -> 'venha' ist der Conjuntivo von 'vir')."
            ]
        }
    ]
}