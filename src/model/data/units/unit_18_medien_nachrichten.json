    "grammarGuide": [
        {
            "heading": "Em direto vs. Ao vivo",
            "explanation": "Während Brasilianer bei Live-Übertragungen im Fernsehen immer 'ao vivo' sagen, sieht man im portugiesischen Fernsehen oben in der Ecke immer 'Em direto' eingeblendet.",
            "examples": [
                "O telejornal é transmitido em direto. (Die Nachrichtensendung wird live übertragen.)"
            ]
        },
        {
            "heading": "O comando",
            "explanation": "Eine weitere Besonderheit: Wenn du in Portugal auf der Couch sitzt und den Sender wechseln willst, bittest du um 'o comando' (die Fernbedienung). Das brasilianische 'controle remoto' wird in Portugal kaum genutzt.",
            "examples": [
                "Podes passar-me o comando? (Kannst du mir die Fernbedienung reichen?)"
            ]
        },
        {
            "heading": "Es gab... (Houve)",
            "explanation": "Das Verb 'haver' in der Bedeutung 'es gibt' wird in Nachrichten oft in der Vergangenheit (Pretérito Perfeito) genutzt. Aus 'há' (es gibt) wird dann 'houve' (es gab / es hat gegeben).",
            "examples": [
                "Houve um acidente grave na autoestrada. (Es gab einen schweren Unfall auf der Autobahn.)",
                "Houve eleições ontem. (Gestern gab es Wahlen.)"
            ]
        }
    ]
}