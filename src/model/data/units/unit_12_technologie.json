    "grammarGuide": [
        {
            "heading": "Europäisches vs. Brasilianisches Portugiesisch",
            "explanation": "In der Technikwelt gibt es massive Unterschiede! In Portugal sagt man z. B. 'telemóvel' (Handy), 'ecrã' (Bildschirm), 'rato' (Maus), 'ficheiro' (Datei), 'palavra-passe' (Passwort) und 'descarregar' (herunterladen). Brasilianische Begriffe wie 'celular', 'tela' oder 'baixar' werden in Portugal zwar verstanden, gelten aber als Fremdkörper.",
            "examples": [
                "PT: O meu telemóvel tem um ecrã novo. (Mein Handy hat einen neuen Bildschirm.)",
                "BR: O meu celular tem uma tela nova."
            ]
        },
        {
            "heading": "Verben für Technik",
            "explanation": "Für das Ein- und Ausschalten von elektronischen Geräten benutzt man 'ligar' (wörtlich: verbinden) und 'desligar' (trennen). Man benutzt nicht 'abrir/fechar' (öffnen/schließen), es sei denn, man meint eine App (Abrir a aplicação).",
            "examples": [
                "Ligar o computador (Den Computer einschalten)",
                "Desligar a televisão (Den Fernseher ausschalten)"
            ]
        },
        {
            "heading": "Speichern vs. Retten (Guardar/Salvar)",
            "explanation": "In Portugal nutzt man für das Speichern von Dateien das Wort 'guardar' (aufbewahren/behalten). Das Wort 'salvar' nutzt man in Europa fast ausschließlich für das Retten von Leben!",
            "examples": [
                "Vou guardar o ficheiro. (Ich werde die Datei speichern.)",
                "O bombeiro salvou o gato. (Der Feuerwehrmann hat die Katze gerettet.)"
            ]
        }
    ]
}