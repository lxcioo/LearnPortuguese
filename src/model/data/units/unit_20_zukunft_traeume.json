    "grammarGuide": [
        {
            "heading": "Planear vs. Planejar",
            "explanation": "Ein klassischer Unterschied: In Portugal sagt man 'planear' (planen), in Brasilien 'planejar'. Wer in Portugal 'planejar' sagt, wird zwar verstanden, outet sich aber sofort als Brasilien-Fan.",
            "examples": [
                "Eu planeio viajar. (Ich plane zu reisen.)"
            ]
        },
        {
            "heading": "Die Zukunft: Ir + Infinitivo",
            "explanation": "Genau wie im Englischen (going to) nutzt man im Portugiesischen im Alltag meistens das Verb 'ir' (gehen/werden) + das Hauptverb in der Grundform, um über die Zukunft zu sprechen.",
            "examples": [
                "Eu vou trabalhar. (Ich werde arbeiten.)",
                "Nós vamos comer. (Wir werden essen.)"
            ]
        },
        {
            "heading": "Der Konditional (Würde)",
            "explanation": "Um Wünsche oder hypothetische Situationen auszudrücken, hängt man an die Grundform des Verbs meistens die Endung '-ia' an.",
            "examples": [
                "Eu faria... (Ich würde machen...)",
                "Eu iria... (Ich würde gehen...)",
                "Gostaria de um café. (Ich hätte gerne einen Kaffee.)"
            ]
        }
    ]
}