    "grammarGuide": [
        {
            "heading": "O Livro de Reclamações",
            "explanation": "Das 'Livro de Reclamações' (Beschwerdebuch) ist eine sehr ernste Angelegenheit in Portugal. Jedes Geschäft, Hotel oder Restaurant ist gesetzlich verpflichtet, es bereitzustellen, wenn der Kunde danach verlangt. Eine Eintragung dort geht direkt an die zuständigen staatlichen Aufsichtsbehörden.",
            "examples": [
                "Traga-me o livro de reclamações, por favor! (Bringen Sie mir bitte das Beschwerdebuch!)"
            ]
        },
        {
            "heading": "A carta de condução & A portagem",
            "explanation": "Im Straßenverkehr gibt es klare EU-PT Begriffe. Den Führerschein nennt man 'A carta de condução' (in Brasilien: Carteira de motorista). Und die Mautgebühren, die fast überall auf Autobahnen fällig werden, heißen 'Portagens'.",
            "examples": [
                "Esqueci-me da minha carta de condução. (Ich habe meinen Führerschein vergessen.)",
                "Temos de pagar a portagem. (Wir müssen die Maut bezahlen.)"
            ]
        },
        {
            "heading": "Avariado vs. Partido",
            "explanation": "Wenn etwas 'kaputt' ist, muss man in Portugal unterscheiden: 'Avariado' nutzt man für elektronische Geräte oder Maschinen, die einen technischen Defekt haben (Klimaanlage, Auto, Aufzug). 'Partido' nutzt man für Dinge, die physisch zerbrochen sind (Glas, Teller).",
            "examples": [
                "O carro está avariado. (Das Auto hat eine Panne / einen Defekt.)",
                "O copo está partido. (Das Glas ist zerbrochen.)"
            ]
        }
    ]
}