    "grammarGuide": [
        {
            "heading": "O Multibanco",
            "explanation": "Das 'Multibanco'-System ist einzigartig in Portugal. Es ist nicht nur ein Geldautomat, sondern ein Netzwerk, mit dem man fast alles machen kann: Steuern zahlen, Handy aufladen, Mautgebühren begleichen und Bahntickets kaufen. Auch das Kartenterminal an der Kasse wird umgangssprachlich oft 'Multibanco' genannt.",
            "examples": [
                "Pode pagar no multibanco. (Sie können am Terminal/Geldautomaten bezahlen.)",
                "Vou ao multibanco levantar dinheiro. (Ich gehe zum Geldautomaten, um Geld abzuheben.)"
            ]
        },
        {
            "heading": "O NIF / Contribuinte",
            "explanation": "Die Número de Identificação Fiscal (NIF) oder 'Número de Contribuinte' ist die portugiesische Steuernummer. In fast jedem Geschäft oder Restaurant wird man beim Bezahlen gefragt: 'Quer contribuinte na fatura?' (Möchten Sie die Steuernummer auf der Rechnung?). Dies dient der portugiesischen Steuererklärung.",
            "examples": [
                "Sim, o meu NIF é o 123456789. (Ja, meine Steuernummer ist die 123456789.)",
                "Não, obrigado. (Nein, danke - wenn man die Nummer nicht angeben will.)"
            ]
        },
        {
            "heading": "Geld abheben: Levantar",
            "explanation": "Das Verb für 'Geld abheben' lautet 'levantar dinheiro' (wörtlich: Geld anheben). Das Verb 'tirar' (ziehen/nehmen) wird in diesem Kontext in Portugal nicht verwendet.",
            "examples": [
                "Tenho de levantar dinheiro. (Ich muss Geld abheben.)"
            ]
        }
    ]
}