    "grammarGuide": [
        {
            "heading": "Hunde und Welpen",
            "explanation": "Ein großer Stolperstein: In Portugal ist ein Hund 'um cão'. Das Wort 'cachorro' benutzt man in Portugal nur für Hunde-Welpen! (In Brasilien ist 'cachorro' der normale Hund).",
            "examples": [
                "O meu cão é grande. (Mein Hund ist groß.)",
                "Olha, que cachorro tão fofo! (Schau, was für ein süßer Welpe!)"
            ]
        },
        {
            "heading": "Die Verlaufsform (Está a chover)",
            "explanation": "Um zu sagen, dass etwas *jetzt gerade* passiert (wie das englische -ing), benutzt man in Portugal 'Estar a + Infinitiv'.",
            "examples": [
                "Está a chover. (Es regnet gerade / It is raining.)",
                "O cão está a dormir. (Der Hund schläft gerade.)"
            ]
        },
        {
            "heading": "Ecopontos",
            "explanation": "Wenn man in Portugal Müll entsorgt, spricht man von den 'Ecopontos'. Es gibt den blauen (Papier/papeleira), den gelben (Plastik/embalagens) und den grünen (Glas/vidro).",
            "examples": [
                "Vou pôr o vidro no ecoponto. (Ich werde das Glas in den Recycling-Container werfen.)"
            ]
        }
    ]
}