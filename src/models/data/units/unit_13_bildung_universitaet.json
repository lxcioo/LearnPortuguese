    "grammarGuide": [
        {
            "heading": "Estudar vs. Aprender",
            "explanation": "Im Portugiesischen unterscheidet man genau zwischen diesen zwei Wörtern. 'Estudar' nutzt man, wenn man sich aktiv hinsetzt und büffelt oder an einer Uni eingeschrieben ist. 'Aprender' bedeutet, dass man eine neue Fähigkeit erlangt (z. B. schwimmen lernen) oder das Wissen tatsächlich im Kopf bleibt.",
            "examples": [
                "Eu estudo na universidade. (Ich studiere an der Universität.)",
                "Eu aprendo a falar português. (Ich lerne Portugiesisch sprechen.)"
            ]
        },
        {
            "heading": "Vorlesungen und Prüfungen",
            "explanation": "Man sagt nicht 'eine Prüfung nehmen/schreiben' (wie im Englischen oder Deutschen), sondern man 'macht' sie: 'Fazer um exame'. Eine Vorlesung 'hat' man: 'Ter uma aula'.",
            "examples": [
                "Amanhã vou fazer um exame. (Morgen werde ich eine Prüfung schreiben.)",
                "Hoje não tenho aulas. (Heute habe ich keine Vorlesungen/keinen Unterricht.)"
            ]
        },
        {
            "heading": "A Propina – Ein falscher Freund!",
            "explanation": "Vorsicht in Portugal! 'A propina' bedeutet an einer portugiesischen Universität die 'Studiengebühren'. In Brasilien und vielen spanischsprachigen Ländern bedeutet das Wort hingegen 'Trinkgeld' oder sogar 'Schmiergeld'!",
            "examples": [
                "Eu tenho de pagar a propina. (Ich muss die Studiengebühr bezahlen.)",
                "Para o café, deixamos gorjeta. (Für den Kaffee hinterlassen wir Trinkgeld.)"
            ]
        }
    ]
}